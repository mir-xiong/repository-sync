# 浏览器访问端口。改掉之后，同时修改下面的 CORS_ORIGINS。
WEB_PORT=8080

# 首次启动时用来创建管理员。管理员已经存在时，只改这一项不会改变登录密码。
INITIAL_ADMIN_PASSWORD=change-me

# 设为 1 时，启动会用上面的密码重置管理员，并让已有登录失效。重置成功后改回 0，再重启一次。
ADMIN_PASSWORD_RESET=0

# 容器内数据目录。compose 会把它固定为 /data，并挂到数据卷。请保持这一项。
DATA_DIR=/data

# 留空时使用 /data/app.db。外部数据库示例：
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/repository_sync
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/repository_sync?charset=utf8mb4

# 加密令牌的密钥。留空时写入 /data/secret.key。设定后请保持不变。
# SECRET_KEY=

# 设为 1 时按仓库调度自动同步。设为 0 时只保留手动同步。
SCHEDULER_ENABLED=1

# 允许浏览器携带登录 Cookie 的来源。必须和浏览器地址栏里的协议、主机、端口一致。
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# 单次 Git 命令的超时秒数。
GIT_TIMEOUT_SECONDS=600

# 容器内保持关闭。上游只接受 GitHub 和 Gitee 的 HTTPS 地址。
ALLOW_FILE_UPSTREAMS=0
