# 首次启动时用来创建管理员。管理员已经存在时，只改这一项不会改变登录密码。
INITIAL_ADMIN_PASSWORD=change-me

# 设为 1 时，启动会用上面的密码重置管理员，并让已有登录失效。重置成功后改回 0，否则每次启动都会再次重置。
ADMIN_PASSWORD_RESET=0

# 数据目录，存放 SQLite、加密密钥和内部镜像。相对路径相对于仓库根目录。留空时使用仓库下的 data。
# DATA_DIR=data

# 数据库连接。留空时使用数据目录下的 SQLite 文件 app.db。
# PostgreSQL：
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/repository_sync
# MySQL：
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/repository_sync?charset=utf8mb4

# 加密 GitHub、Gitee 令牌和 WebDAV 密码的密钥。留空时自动生成并写入数据目录的 secret.key。设定后请保持不变，更换后已保存的令牌无法解密。
# SECRET_KEY=

# 设为 1 时按仓库调度自动同步。设为 0 时接口仍可手动同步，不跑定时任务。
SCHEDULER_ENABLED=1

# 设为 1 时允许把本机绝对路径当作上游。默认关闭，上游只接受 GitHub 和 Gitee 的 HTTPS 地址。
# ALLOW_FILE_UPSTREAMS=0

# 允许浏览器携带登录 Cookie 的来源，多个用英文逗号分隔。前端改端口后改成对应地址。
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 单次 Git 命令的超时秒数。
# GIT_TIMEOUT_SECONDS=600

# 下面三项是默认端口的记录。make dev 不读取 .env。
# 改端口示例：make dev BACKEND_PORT=9000 FRONTEND_PORT=4173
# 前端端口改变后，同时修改上面的 CORS_ORIGINS。
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_URL=http://127.0.0.1:8000
